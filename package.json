{
  "name": "screenpilot",
  "version": "0.1.0",
  "description": "AI pilot for screen videos: records any desktop app (or drives it), then edits it into a polished video with zooms, captions and voiceover.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "screenpilot": "dist/cli.js",
    "screenpilot-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "skill",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:windows": "tsx scripts/windows-smoke.ts",
    "deps:latest": "pnpm update --latest && pnpm outdated",
    "windows:live": "tsx scripts/windows-live.ts",
    "package": "tsx scripts/build-mcpb.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "dbus-next": "^0.10.2",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.207",
    "koffi": "^3.3.4",
    "msedge-tts": "^2.1.1",
    "obs-websocket-js": "^5.0.8",
    "playwright-core": "^1.64.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.13.1"
}
